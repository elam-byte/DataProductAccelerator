# Copy this to .env and fill in your values.
# All variables are prefixed with DPA_.

# MinIO (S3-compatible object store)
DPA_MINIO_ENDPOINT=http://localhost:9000
DPA_MINIO_ACCESS_KEY=minioadmin
DPA_MINIO_SECRET_KEY=minioadmin
DPA_MINIO_REGION=us-east-1

# Iceberg REST catalog (tabulario/iceberg-rest)
DPA_ICEBERG_CATALOG_URI=http://localhost:8181
DPA_ICEBERG_WAREHOUSE=s3://iceberg-warehouse/

# OpenMetadata API
DPA_OPENMETADATA_URL=http://localhost:8585
# JWT token — generated by OM on first boot:
# docker exec openmetadata-server python /opt/openmetadata/bootstrap/generate_token.py
DPA_OPENMETADATA_TOKEN=

# Local paths
DPA_DAGSTER_HOME=./dagster_pipelines
DPA_GE_PROJECT_ROOT=./ge_project
DPA_DBT_PROJECT_ROOT=./dbt_project
DPA_CATALOG_DB_PATH=./.dpa/catalog.db

# Spark (only needed for dpa run — not required for dpa deploy)
DPA_SPARK_MASTER=local[*]

# PRODUCTION NOTE: Replace hardcoded credentials with Vault/AWS Secrets Manager references.
