from dagster import AssetKey, FreshnessPolicy, Output, asset


{% for table in config.tables %}
@asset(
    name="{{ table.name }}",
    group_name="{{ config.name }}",
    key_prefix="{{ config.name }}",
    description="{{ table.description or (table.tier.value ~ ' tier table for ' ~ config.name) }}",
    metadata={
        "tier": "{{ table.tier.value }}",
        "product": "{{ config.name }}",
        "version": "{{ config.version }}",
        "iceberg_location": "s3://{{ config.bucket_name }}/{{ table.tier.value }}/{{ table.name }}",
        "owner": "{{ config.owner.team }}",
        "pii_columns": {{ table.pii_columns | map(attribute="name") | list | tojson }},
    },
    freshness_policy=FreshnessPolicy(maximum_lag_minutes={{ config.sla.freshness_hours * 60 }}),
)
def {{ config.name }}__{{ table.name }}(context) -> Output:
    """{{ table.description or (table.name ~ ' (' ~ table.tier.value ~ ')') }}"""
    # TODO: implement materialization logic
    # Example for Spark:
    #   from pyspark.sql import SparkSession
    #   spark = SparkSession.builder.getOrCreate()
    #   df = spark.table("{{ config.namespace }}.{{ table.name }}")
    context.log.info("Materializing {{ config.name }}.{{ table.name }}")
    return Output(None, metadata={"rows_written": 0})


{% endfor %}
assets = [{{ config.tables | map(attribute="name") | map("format", config.name ~ "__{0}") | join(", ") }}]
